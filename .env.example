# Copy this file to `.env` and fill in real values.
# Never commit your real `.env`.

# PostgreSQL connection string used by the application and Prisma CLI.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/npi_dev

# Used only by the integration test suite (vitest) against a separate database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/npi_test

# TLS mode for the application connection. One of:
#   disable     no TLS (local development only)
#   require     TLS, certificate chain not verified  <- default for remote hosts
#   verify-ca   TLS, chain verified
#   verify-full TLS, chain and hostname verified
# Leave unset locally: the app auto-detects localhost and disables TLS.
# Managed providers (Neon, Supabase) normally work with the `require` default.
# Set this only if your provider's CA is present in the runtime trust store and
# you want full verification.
# DATABASE_SSL=require

# Connection pool size per serverless instance. Default 5, or 1 when the URL
# contains `?pgbouncer=true` (transaction poolers cannot hold session state).
# Keep the total (instances x max) under your provider's connection limit.
# DATABASE_POOL_MAX=5

# How long to wait for a connection before failing. Default 8000.
# DATABASE_CONNECTION_TIMEOUT_MS=8000

# Secret used to pepper password hashes and sign session material.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-32-byte-hex-string

# Session lifetime in days.
SESSION_TTL_DAYS=7
